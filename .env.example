# Database
DATABASE_URL="postgresql://user:password@host/database"

# File uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Admin
ADMIN_PASSWORD="change-me"

# Subscription email delivery (Resend)
# Leave RESEND_API_KEY empty to keep delivery switched off: subscriptions are
# still stored and shown in /admin/subscriptions, and every send is logged and
# skipped. Fill both values in to start sending immediately — no code change.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Beauty Professionals Magazine <hello@beautyprofessionalsmagazine.com>"

# Optional: address that receives a notification for each new subscription.
SUBSCRIPTION_NOTIFICATION_EMAIL=""
